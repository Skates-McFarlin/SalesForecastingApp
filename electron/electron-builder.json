{
    "appId": "com.insighta.app",
    "productName": "Insighta",
    "directories": {
        "output": "dist-electron"
    },
    "files": [
        "main.js",
        "package.json",
        "icon.ico",
        "build/**/*"
    ],
    "extraResources": [
        {
            "from": "../backend/dist/run",
            "to": "backend"
        },
        {
            "from": "../backend/llamacpp",
            "to": "backend/llamacpp"
        }
    ],
    "win": {
        "target": "nsis",
        "icon": "icon.ico",
        "signAndEditExecutable": false
    },
    "asar": false
}